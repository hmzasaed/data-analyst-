# Reference for the environment variables InsightFlow reads. Every setting is optional.
# These are read from the process environment (no .env file is loaded automatically):
# export them in your shell, or use `uv run --env-file .env python -m insightflow_api`.

# --- Where jobs run ---------------------------------------------------------
# inline     - inside the upload request (tests, scripts)
# background - on a thread in the API process; the web UI polls progress (default for `python -m insightflow_api`)
# worker     - queued; run `uv run python -m insightflow_worker` alongside the API
INSIGHTFLOW_EXECUTION_MODE=background

# --- Job state database -------------------------------------------------------
# Default: local SQLite, no setup.
INSIGHTFLOW_STATE_DATABASE_URL=sqlite:///./artifacts/insightflow.db
# Supabase: Project settings -> Database -> Connection string (URI).
# The transaction pooler (port 6543) is supported. The schema is created on startup,
# or apply infra/supabase/migrations/*.sql yourself.
# INSIGHTFLOW_STATE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Language model (optional; planning and prose only, never numbers) --------
INSIGHTFLOW_LLM_ENABLED=false
# INSIGHTFLOW_LLM_BASE_URL=https://api.openai.com/v1
# INSIGHTFLOW_LLM_API_KEY=
# INSIGHTFLOW_LLM_FAST_MODEL=gpt-4o-mini
# INSIGHTFLOW_LLM_REASONING_MODEL=gpt-4o

# --- Web ----------------------------------------------------------------------
# Origins allowed to call the API directly (the Vite dev server proxies, so this is rarely needed).
INSIGHTFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
